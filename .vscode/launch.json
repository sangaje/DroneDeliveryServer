    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐍 FastAPI: Uvicorn (dev)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/Launch.py",
            "console": "integratedTerminal",
            "jinja": true
        },
        {
            "name": "🐍 Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s", "${file}"],
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
    
}